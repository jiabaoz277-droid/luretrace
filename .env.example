# 复制为 .env 后填写；不要把真实密钥提交到仓库

# ===== 运行环境 =====
# 生产环境设为 prod（同时会：强制登录生效、数据库默认切到 /tmp/data/app.db）
ENV=dev

# ===== 登录（邀请码换 token）=====
# 邀请码由 AI 生成后交给产品经理分发；多个用英文逗号分隔
INVITE_CODES=CODE1,CODE2
# token 签名密钥（生产环境必须设置，且不提交到仓库；用 openssl rand -hex 32 生成）
TOKEN_SECRET=
# token 有效期（秒），默认 30 天
TOKEN_TTL_SECONDS=2592000

# ===== 模型（OpenAI 兼容接口，DeepSeek 默认）=====
# 真实模型接入：填上 KEY 后重启后端即可，不填则自动用规则+模板兜底
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 火山方舟（豆包）示例（二选一，替换上面三行）：
# MODEL_API_KEY=你的火山方舟API Key
# MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_NAME=你的推理接入点ID（如 ep-xxxxxxxx 或模型名）

# ===== 天气/地理数据源（和风天气 QWeather）=====
# 注册 https://dev.qweather.com 创建 API Key；专属 API Host 在控制台-设置中查看（形如 xxx.qweatherapi.com）
# 不填则天气降级为 mock
QWEATHER_KEY=
QWEATHER_API_HOST=

# ===== 数据与前端 =====
# 本地开发默认 sqlite:///./data/fishing.db；生产(ENV=prod)默认 sqlite:////tmp/data/app.db
DATABASE_URL=sqlite:///./data/fishing.db
# 地图水域数据源（OpenStreetMap Overpass，免费、无需 Key；默认即可，可换国内镜像）
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ===== 高德地图（Amap）=====
# 用于地理编码 + 水域/钓场 POI 搜索（注册 https://lbs.amap.com 创建 Key）
AMAP_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ===== 错误监控（可选）=====
# 配置后自动捕获未处理异常；不配则跳过
SENTRY_DSN=

# ===== 对象存储备份（可选；未配置 S3 时退化为本地 /tmp 副本）=====
STORAGE_PROVIDER=
# TOS 的 S3 兼容 endpoint 形如 https://tos-s3-cn-beijing.volces.com
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=cn-beijing
# 备份间隔（秒），默认 300
BACKUP_INTERVAL_SECONDS=300
