# 复制为 .env 后填写；不要把真实密钥提交到仓库

# ===== 模型（OpenAI 兼容接口，DeepSeek 默认）=====
# 真实模型接入：填上 KEY 后重启后端即可，不填则自动用规则+模板兜底
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 火山方舟（豆包）示例（二选一，替换上面三行）：
# MODEL_API_KEY=你的火山方舟API Key
# MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_NAME=你的推理接入点ID（如 ep-xxxxxxxx 或模型名）

# ===== 天气/地理数据源（和风天气 QWeather）=====
# 注册 https://dev.qweather.com 创建 API Key；不填则天气降级为 mock
QWEATHER_KEY=

# ===== 数据与前端 =====
DATABASE_URL=sqlite:///./data/fishing.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
